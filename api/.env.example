# Backend environment example

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173

# Authentication should not be Basic Auth.
AUTH_MODE=app_login
SESSION_COOKIE_NAME=eastie_session
SESSION_DAYS=7
BCRYPT_ROUNDS=12
RESET_TOKEN_MINUTES=30

# SQLite path for local/internal version. Later this can become a Postgres URL
# after replacing the small db access layer.
DATABASE_URL=./db/eastie.sqlite

# Local seed users. Do not reuse demo passwords in production.
# In NODE_ENV=production, seed refuses to run unless ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=admin@eastie.demo
SEED_ADMIN_PASSWORD=demo-password
SEED_TEACHER_EMAIL=teacher@eastie.demo
SEED_TEACHER_PASSWORD=demo-password

# Password reset email. If SMTP_HOST is unset, reset links are logged to console.
EMAIL_FROM=EASTIE Curriculum <no-reply@eastie.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
